

# ----------------------------------
# CONFIGURATION
# ----------------------------------
DB_URI = "mysql+pymysql://username:password@localhost/fleximart"
# For PostgreSQL:
# DB_URI = "postgresql://username:password@localhost/fleximart"

CUSTOMERS_FILE = "customers_raw.csv"
PRODUCTS_FILE = "products_raw.csv"
SALES_FILE = "sales_raw.csv"

logging.basicConfig(
    filename="etl.log",
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

# ----------------------------------
# HELPER FUNCTIONS
# ----------------------------------
def standardize_phone(phone):
    if pd.isna(phone):
        return None
    digits = re.sub(r"\D", "", phone)
    if digits.startswith("91"):
        digits = digits[2:]
    if digits.startswith("0"):
        digits = digits[1:]
    return f"+91-{digits}" if len(digits) == 10 else None


def standardize_date(date_val):
    if pd.isna(date_val):
        return None
    for fmt in ("%Y-%m-%d", "%d/%m/%Y", "%m-%d-%Y", "%m/%d/%Y"):
        try:
            return datetime.strptime(str(date_val), fmt).date()
        except ValueError:
            continue
    return None


def clean_category(cat):
    return cat.strip().capitalize()


# ----------------------------------
# EXTRACT
# ----------------------------------
def extract_data():
    customers = pd.read_csv(CUSTOMERS_FILE)
    products = pd.read_csv(PRODUCTS_FILE)
    sales = pd.read_csv(SALES_FILE)
    return customers, products, sales


# ----------------------------------
# TRANSFORM
# ----------------------------------
def transform_customers(df):
    initial = len(df)
    df = df.drop_duplicates(subset=["customer_id"])
    duplicates = initial - len(df)

    df["email"] = df["email"].fillna("")
    missing_email = (df["email"] == "").sum()
    df = df[df["email"] != ""]

    df["phone"] = df["phone"].apply(standardize_phone)
    df["city"] = df["city"].str.strip().str.title()
    df["registration_date"] = df["registration_date"].apply(standardize_date)

    logging.info(f"Customers: {duplicates} duplicates removed, {missing_email} missing emails dropped")
    return df


def transform_products(df):
    initial = len(df)
    df = df.drop_duplicates()
    duplicates = initial - len(df)

    missing_price = df["price"].isna().sum()
    df = df.dropna(subset=["price"])

    df["stock_quantity"] = df["stock_quantity"].fillna(0).astype(int)
    df["category"] = df["category"].apply(clean_category)
    df["product_name"] = df["product_name"].str.strip()

    logging.info(f"Products: {duplicates} duplicates removed, {missing_price} missing prices dropped")
    return df


def transform_sales(df):
    initial = len(df)
    df = df.drop_duplicates(subset=["transaction_id"])
    duplicates = initial - len(df)

    missing_ids = df["customer_id"].isna().sum() + df["product_id"].isna().sum()
    df = df.dropna(subset=["customer_id", "product_id"])

    df["transaction_date"] = df["transaction_date"].apply(standardize_date)

    logging.info(f"Sales: {duplicates} duplicates removed, {missing_ids} records with missing IDs dropped")
    return df


# ----------------------------------
# LOAD
# ----------------------------------
def load_data(customers, products, sales):
    engine = create_engine(DB_URI)

    with engine.begin() as conn:
        customers[[
            "first_name", "last_name", "email",
            "phone", "city", "registration_date"
        ]].to_sql("customers", conn, if_exists="append", index=False)

        products[[
            "product_name", "category", "price", "stock_quantity"
        ]].to_sql("products", conn, if_exists="append", index=False)

        # Load orders + order_items
        for _, row in sales.iterrows():
            result = conn.execute(
                """
                INSERT INTO orders (customer_id, order_date, total_amount, status)
                VALUES (%s, %s, %s, %s)
                """,
                (
                    row["customer_id"],
                    row["transaction_date"],
                    row["quantity"] * row["unit_price"],
                    row["status"]
                )
            )
            order_id = result.lastrowid

            conn.execute(
                """
                INSERT INTO order_items (order_id, product_id, quantity, unit_price, subtotal)
                VALUES (%s, %s, %s, %s, %s)
                """,
                (
                    order_id,
                    row["product_id"],
                    row["quantity"],
                    row["unit_price"],
                    row["quantity"] * row["unit_price"]
                )
            )

    logging.info("Data successfully loaded into database")


# ----------------------------------
# MAIN PIPELINE
# ----------------------------------
def main():
    customers, products, sales = extract_data()
    customers = transform_customers(customers)
    products = transform_products(products)
    sales = transform_sales(sales)
    load_data(customers, products, sales)
    print("ETL Pipeline executed successfully.")


if __name__ == "__main__":
    main()
